// ============================================================
// Growing Seed — Firestore Security Rules
// ============================================================
//
// firebase.json deploys this file directly with the Firebase CLI.
//
// WHY THIS FILE MATTERS: right now, every permission check in the
// sandbox (Super Admin locks, who can reset progress, who can activate
// seasonal events) lives only in admin.js / script.js — JavaScript
// running in the player's own browser. That's fine for a local demo,
// but it means a technically inclined player could open devtools and
// simply call the functions directly, bypassing every UI restriction.
// These rules move that enforcement to the server, where a player
// cannot override it no matter what they do in their own browser.
//
// Before deploying, fill in the two locked Super Admin UIDs below (not
// emails — Firestore rules check the
// authenticated UID, so look up each locked account's UID once in the
// Firebase Console → Authentication tab after they've registered), and
// deploy with `firebase deploy --only firestore:rules` or paste into
// Firestore → Rules in the console.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // UID checks are retained as an additional defense once the accounts
    // exist. Email checks below handle first sign-in safely.
    function isLockedSuperAdminUid(uid) {
      return uid in [
        'REPLACE_WITH_ENDLESSSH0014_UID',
        'REPLACE_WITH_ENDLESSNOGU_UID'
      ];
    }

    function isLockedSuperAdminEmail(email) {
      return email in [
        'endlesssh0014@gmail.com',
        'endlessnogu@gmail.com'
      ];
    }

    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return request.auth != null && currentUserRole() == 'superadmin';
    }

    function isAdminOrAbove() {
      return request.auth != null &&
        (currentUserRole() == 'admin' || currentUserRole() == 'superadmin');
    }

    function isModeratorOrAbove() {
      return request.auth != null &&
        (currentUserRole() == 'moderator' || isAdminOrAbove());
    }

    function hasAcceptedPulseRequest(fromUid, toUid) {
      let requestId = fromUid + '_' + toUid;
      return exists(/databases/$(database)/documents/pulseRequests/$(requestId))
        && get(/databases/$(database)/documents/pulseRequests/$(requestId)).data.status == 'accepted';
    }

    function canViewProfile(uid) {
      return request.auth != null
        && (uid == request.auth.uid
          || resource.data.profileVisibility == 'public'
          || (resource.data.profileVisibility == 'followers'
            && (
              exists(/databases/$(database)/documents/connections/$(uid)/users/$(request.auth.uid))
              || hasAcceptedPulseRequest(uid, request.auth.uid)
              || hasAcceptedPulseRequest(request.auth.uid, uid)
            )));
    }

    function isValidCommentAppend(oldComments, newComments) {
      let comment = newComments[oldComments.size()];
      return newComments.size() == oldComments.size() + 1
        && newComments.size() <= 100
        && newComments.hasAll(oldComments)
        && comment.keys().hasOnly(['id', 'uid', 'author', 'text'])
        && comment.keys().hasAll(['id', 'uid', 'author', 'text'])
        && comment.id is string
        && comment.uid == request.auth.uid
        && comment.author is string
        && comment.author.size() <= 80
        && comment.text is string
        && comment.text.size() > 0
        && comment.text.size() <= 120;
    }

    // ---- users/{uid} ----
    match /users/{uid} {
      // Private gameplay documents are readable by their owner and staff.
      // Public discoverability belongs in publicProfiles/{uid} below.
      allow get: if request.auth != null
        && (request.auth.uid == uid || isModeratorOrAbove());
      allow list: if isModeratorOrAbove();

      // A player can update their own document, EXCEPT the fields that
      // must go through an admin action or a locked/one-time rule.
      allow update: if request.auth != null && request.auth.uid == uid
        && !("role" in request.resource.data.diff(resource.data).affectedKeys())
        && !("roleLocked" in request.resource.data.diff(resource.data).affectedKeys())
        // Email is permanently locked once set — no update path at all
        // once resource.data.email already has a non-empty value.
        && (resource.data.email == "" || request.resource.data.email == resource.data.email);

      // Role changes: only a Super Admin, and never on a locked account.
      allow update: if isSuperAdmin()
        && !isLockedSuperAdminUid(uid)
        && !isLockedSuperAdminEmail(resource.data.email)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

      // Resetting another player's progress: Admin or Super Admin only.
      allow update: if isAdminOrAbove()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['faithPoints', 'treeProgress', 'fruitCount', 'streak']);

      // Creating your own user doc happens once, at registration.
      allow create: if request.auth != null
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && (
          (
            request.auth.uid == uid
            && (
              (
                isLockedSuperAdminEmail(request.auth.token.email)
                && request.resource.data.role == 'superadmin'
                && request.resource.data.roleLocked == true
              )
              || (
                !isLockedSuperAdminEmail(request.auth.token.email)
                && request.resource.data.role == 'user'
              )
            )
          )
          || (
            isAdminOrAbove()
            && request.resource.data.role in [
              'user',
              'leader',
              'moderator',
              'admin',
              'superadmin'
            ]
          )
        );

      // Admins may complete the client-side soft-delete flow by removing
      // the source document after copying it to deletedUsers. Locked
      // Super Admins and the caller's own account remain protected.
      allow delete: if isAdminOrAbove()
        && uid != request.auth.uid
        && !isLockedSuperAdminUid(uid)
        && !isLockedSuperAdminEmail(resource.data.email);
    }

    // ---- publicProfiles/{uid} ----
    // Keep discoverable profile data separate from private gameplay data.
    match /publicProfiles/{uid} {
      allow read: if canViewProfile(uid);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'nameLower', 'emailLower', 'avatarId', 'treeName',
          'stage', 'badges', 'profileVisibility'
        ]);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ---- pulseRequests/{requestId} ----
    match /pulseRequests/{requestId} {
      allow create: if request.auth != null
        && requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if request.auth != null
        && resource.data.fromUid == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Relationship controls are private to the account that owns them.
    match /blocks/{uid}/users/{blockedUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /mutes/{uid}/users/{mutedUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Feed posts are bounded by ownership and moderation state. Production
    // writes should also be checked by a callable function for caption rules.
    match /faithFeedPosts/{postId} {
      allow read: if isModeratorOrAbove()
        || (request.auth != null
          && resource.data.moderationStatus == 'approved'
          && resource.data.visibility == 'public');
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.moderationStatus == 'pending'
        && request.resource.data.visibility == 'public'
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 16
        && request.resource.data.get('reactions', {}) == {}
        && request.resource.data.get('comments', []) == []
        && request.resource.data.createdAt == request.time
        && (!('imageDataUrl' in request.resource.data)
          || request.resource.data.imageDataUrl is string
          && request.resource.data.imageDataUrl.size() <= 900000);
      // Authors may edit a pending post, but cannot approve their own content.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.moderationStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text', 'imageDataUrl', 'updatedAt'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200;
      // Moderators make the server-side approval decision.
      allow update: if isModeratorOrAbove()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStatus', 'moderationNote', 'moderatedAt', 'moderatedBy'
        ])
        && request.resource.data.moderationStatus in ['approved', 'rejected', 'hidden'];
      // Each signed-in player can set or clear only their own reaction.
      allow update: if request.auth != null
        && resource.data.moderationStatus == 'approved'
        && resource.data.visibility == 'public'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get('reactions', {}))
          || request.resource.data.reactions[request.auth.uid] in ['🔥', '🙏', '👏']);
      // Comments append atomically so concurrent commenters do not overwrite each other.
      allow update: if request.auth != null
        && resource.data.moderationStatus == 'approved'
        && resource.data.visibility == 'public'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        && isValidCommentAppend(
          resource.data.get('comments', []),
          request.resource.data.get('comments', [])
        );
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isModeratorOrAbove());
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read, update: if isModeratorOrAbove();
    }

    match /shareHistory/{shareId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sourceType in ['rank', 'teamRank', 'progress', 'verse', 'feedPost']
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 200
        && (!('sourceId' in request.resource.data)
          || request.resource.data.sourceId == null
          || request.resource.data.sourceId is string)
        && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && resource.data.recipientUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.type == 'team_reminder'
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.teamId is string
        && request.resource.data.recipientUid is string
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.leaderUid == request.auth.uid
        && request.resource.data.recipientUid in get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.memberUids;
      allow delete: if false;
    }

    // ---- deletedUsers/{uid} — soft-deleted players ----
    match /deletedUsers/{uid} {
      allow read, write: if isModeratorOrAbove();
    }

    // ---- teams/{teamId} ----
    match /teams/{teamId} {
      allow read: if request.auth != null;

      // Only the team's leader can add/remove members, approve/decline
      // requests, or rename the team.
      allow update: if request.auth != null
        && (
          resource.data.leaderUid == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests'])
            && request.resource.data.requests.size() == resource.data.requests.size() + 1
            && request.resource.data.requests.hasAll(resource.data.requests)
            && request.auth.uid != resource.data.leaderUid
          )
        );

      // Any signed-in user can create a new team (the 500 FP cost should
      // ideally be enforced by a Cloud Function that checks the balance
      // server-side before creating the team, rather than trusting the
      // client to have actually paid).
      allow create: if request.auth != null;

      allow delete: if isModeratorOrAbove();
    }

    // ---- sharedEvent/current — seasonal event toggle ----
    match /sharedEvent/{docId} {
      allow read: if true; // every client needs to see if an event is active
      allow write: if isSuperAdmin(); // only Super Admins can activate/deactivate
    }

    // ---- teamFeed/{teamId}/posts/{postId} ----
    match /teamFeed/{teamId}/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;

      // Reactions: a player may only ever write their OWN entry in the
      // reactions map (enforces "one reaction per person" server-side,
      // matching the client-side rule already built into the sandbox).
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['reactions'])
        && request.resource.data.reactions.diff(resource.data.reactions)
             .affectedKeys().hasOnly([request.auth.uid]);
    }
  }
}
